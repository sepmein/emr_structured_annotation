<View className="ls-page">

  <Style>
    .ls-page {
    background: #f3f6fa;
    padding: 12px;
    color: #1f2937;
    }

    .ls-page h3,
    .ls-page h4,
    .ls-page h5,
    .ls-page .ant-typography {
    margin: 0 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    color: #1f2937 !important;
    }

    .topbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    background: #ffffff;
    border: 1px solid #e2eaf3;
    border-radius: 10px;
    padding: 8px 12px;
    margin-bottom: 10px;
    }

    .topbar-title {
    margin: 0;
    padding: 0;
    border: none;
    white-space: nowrap;
    }

    .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    }

    .meta-pill {
    background: #f8fafc;
    border: 1px solid #e6edf5;
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    color: #475467;
    }

    .main {
    display: flex;
    width: 100%;
    gap: 16px;
    align-items: flex-start;
    }

    .left {
    flex: 0 0 400px;
    width: 400px;
    max-height: 88vh;
    overflow-y: auto;
    position: sticky;
    top: 8px;
    }

    .right {
    flex: 1 1 auto;
    min-width: 0;
    }

    .group {
    background: #ffffff;
    border: 1px solid #e6edf5;
    border-radius: 8px;
    margin-bottom: 5px;
    overflow: hidden;
    }

    .group-head {
    padding: 3px 8px;
    border-bottom: 1px solid #eef3f8;
    background: #f8fafc;
    }

    .group-head h3,
    .group-head h4,
    .group-head h5,
    .group-head .ant-typography {
    font-size: 12px !important;
    }

    .group-body {
    padding: 4px 6px;
    background: #ffffff;
    }

    .modifier-panel {
    background: #f4f6f8;
    border: 1px dashed #b7c3d0;
    border-radius: 10px;
    padding: 6px;
    margin-bottom: 8px;
    }

    .modifier-head {
    padding: 2px 4px 6px;
    }

    .modifier-head h3,
    .modifier-head h4,
    .modifier-head h5,
    .modifier-head .ant-typography {
    font-size: 11px !important;
    color: #667085 !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em;
    }

    .modifier-row {
    display: flex;
    gap: 6px;
    }

    .modifier-row + .modifier-row {
    margin-top: 6px;
    }

    .modifier-panel .group {
    flex: 1;
    min-width: 0;
    margin-bottom: 0;
    background: #ffffff;
    border-style: dashed;
    }

    .tone-red .group-head {
    border-left: 3px solid #D32F2F;
    background: #fff5f5;
    }

    .tone-orange .group-head {
    border-left: 3px solid #EF6C00;
    background: #fff8f1;
    }

    .tone-cyan .group-head {
    border-left: 3px solid #00838F;
    background: #f1fbfc;
    }

    .tone-slate .group-head {
    border-left: 3px solid #607D8B;
    background: #f5f7f8;
    }

    .tone-indigo .group-head {
    border-left: 3px solid #303F9F;
    background: #f4f5fc;
    }

    .tone-indigo-soft .group-head {
    border-left: 3px solid #5C6BC0;
    background: #f6f7fd;
    }

    .tone-brown .group-head {
    border-left: 3px solid #6D4C41;
    background: #f7f4f2;
    }

    .tone-pathogen .group-head {
    border-left: 3px solid #1565C0;
    background: #f3f8fd;
    }

    .pathogen-sub {
    margin: 4px 0 2px;
    padding-top: 4px;
    border-top: 1px dashed #e8eef5;
    }

    .pathogen-sub:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
    }

    .pathogen-sub h3,
    .pathogen-sub h4,
    .pathogen-sub h5,
    .pathogen-sub .ant-typography {
    font-size: 11px !important;
    color: #667085 !important;
    font-weight: 600 !important;
    }

    .detect-block {
    margin-top: 4px;
    padding: 4px 6px;
    background: #faf4fc;
    border: 1px solid #e1bee7;
    border-radius: 6px;
    }

    .detect-block .pathogen-sub:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
    }

    .detect-block h3,
    .detect-block h4,
    .detect-block h5,
    .detect-block .ant-typography {
    color: #8E24AA !important;
    }

    .relation-card {
    background: #f7faff;
    border: 1px solid #dbeafe;
    border-radius: 8px;
    padding: 5px 8px;
    }

    .reader-shell {
    background: #ffffff;
    border: 1px solid #e2eaf3;
    border-radius: 10px;
    padding: 10px 12px;
    position: sticky;
    top: 8px;
    }


    .reader-head {
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid #edf2f7;
    }

    .text-panel {
    background: #fcfdff;
    border: 1px solid #e8eef5;
    border-radius: 8px;
    padding: 14px 16px;
    max-height: 84vh;
    overflow-y: auto;
    }
    .htx-text {
    white-space: pre-wrap !important;
    font-size: 16px !important;
    line-height: 1.9 !important;
    color: #1f2937 !important;
    }

    .lsf-label,
    .htx-label,
    .ant-tag {
    font-size: 12px !important;
    line-height: 1.4 !important;
    padding: 5px 8px !important;
    margin: 0 4px 5px 0 !important;
    border-radius: 5px !important;
    font-weight: 500 !important;
    min-height: 28px !important;
    height: auto !important;
    display: inline-flex !important;
    align-items: center !important;
    }

    .left::-webkit-scrollbar,
    .text-panel::-webkit-scrollbar {
    width: 8px;
    }

    .left::-webkit-scrollbar-thumb,
    .text-panel::-webkit-scrollbar-thumb {
    background: #d0dbe8;
    border-radius: 8px;
    }
    .ls-page .annotation-help h6,
    .ls-page .annotation-help .ant-typography {
    font-size: 12px !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    color: #667085 !important;
    margin: 0 !important;
    }

  </Style>

